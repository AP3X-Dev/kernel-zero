{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@kernel-zero/contracts": ["packages/contracts/src/index.ts"],
      "@kernel-zero/domain": ["packages/domain/src/index.ts"],
      "@kernel-zero/domain/*": ["packages/domain/src/*"],
      "@kernel-zero/persistence": ["packages/persistence/src/index.ts"],
      "@kernel-zero/profile-manifest": ["packages/profile-manifest/src/index.ts"],
      "@kernel-zero/profile-software-architecture": ["packages/profile-software-architecture/src/index.ts"],
      "@kernel-zero/profile-workflow": ["packages/profile-workflow/src/index.ts"],
      "@kernel-zero/profiles": ["packages/profiles/src/index.ts"],
      "@kernel-zero/testing": ["packages/testing/src/index.ts"],
      "@kernel-zero/validator": ["packages/validator/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.next/**", "packages/validator/fixtures/**"]
}
