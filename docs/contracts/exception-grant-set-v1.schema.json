{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "$ref": "#/$defs/__schema1"
    },
    "workspace": {
      "$ref": "#/$defs/__schema2"
    },
    "policyDigest": {
      "$ref": "#/$defs/__schema3"
    },
    "generatedAt": {
      "$ref": "#/$defs/__schema4"
    },
    "expiresAt": {
      "$ref": "#/$defs/__schema4"
    },
    "grants": {
      "$ref": "#/$defs/__schema5"
    },
    "integrity": {
      "$ref": "#/$defs/__schema7"
    },
    "signature": {
      "$ref": "#/$defs/__schema8"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "workspace",
    "policyDigest",
    "generatedAt",
    "expiresAt",
    "grants",
    "integrity",
    "signature"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "kernel-zero.dev/exceptions/v1"
    },
    "__schema1": {
      "type": "string",
      "const": "ExceptionGrantSet"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "__schema3": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema4": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema5": {
      "minItems": 0,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "exceptionId": {
          "$ref": "#/$defs/__schema2"
        },
        "ruleId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "fingerprint": {
          "$ref": "#/$defs/__schema3"
        },
        "validUntil": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "exceptionId",
        "ruleId",
        "fingerprint",
        "validUntil"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "value": {
          "type": "string",
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        }
      },
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
