{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "kernel-zero.dev/v1"
    },
    "kind": {
      "type": "string",
      "const": "WorkflowPolicy"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "name",
        "revision",
        "description"
      ],
      "additionalProperties": false
    },
    "scope": {
      "default": {
        "include": [
          ".github/workflows/*.yml",
          ".github/workflows/*.yaml"
        ]
      },
      "type": "object",
      "properties": {
        "include": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "include"
      ],
      "additionalProperties": false
    },
    "rules": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "level": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "check": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "pinned-actions"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "sha",
                    "tag"
                  ]
                }
              },
              "required": [
                "kind",
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "restricted-permissions"
                },
                "allowWrite": {
                  "minItems": 0,
                  "maxItems": 30,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                }
              },
              "required": [
                "kind",
                "allowWrite"
              ],
              "additionalProperties": false
            }
          ]
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "title",
        "level",
        "check",
        "remediation"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
