{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "kernel-zero.dev/v1"
    },
    "kind": {
      "type": "string",
      "const": "ManifestPolicy"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "name",
        "revision",
        "description"
      ],
      "additionalProperties": false
    },
    "rules": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "level": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "check": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "allowed-licenses"
                },
                "allowed": {
                  "minItems": 1,
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema1"
                  }
                }
              },
              "required": [
                "kind",
                "allowed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "pinned-dependencies"
                },
                "fields": {
                  "minItems": 1,
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                }
              },
              "required": [
                "kind",
                "fields"
              ],
              "additionalProperties": false
            }
          ]
        },
        "remediation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "id",
        "title",
        "level",
        "check",
        "remediation"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "dependencies",
        "devDependencies",
        "optionalDependencies"
      ]
    }
  }
}
