{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "kernel-zero.dev/custody/v1"
    },
    "kind": {
      "type": "string",
      "const": "PolicyCustodyEvidence"
    },
    "workspace": {
      "$ref": "#/$defs/__schema0"
    },
    "policy": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Za-z]+Policy$"
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "kind",
        "name",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/__schema0"
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "approvalId",
        "digest",
        "approvedAt"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "digest": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "digest",
        "revision",
        "keyId"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "kernel-zero-validator"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "required": [
        "status",
        "errors"
      ],
      "additionalProperties": false
    },
    "findings": {
      "minItems": 0,
      "maxItems": 9,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "integrity": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "workspace",
    "policy",
    "approval",
    "trust",
    "tool",
    "result",
    "findings",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "__schema1": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "CUSTODY_TRUST_INTEGRITY_INVALID",
            "CUSTODY_APPROVAL_INTEGRITY_INVALID",
            "CUSTODY_MAKER_CHECKER_INVALID",
            "CUSTODY_WORKSPACE_MISMATCH",
            "CUSTODY_POLICY_IDENTITY_MISMATCH",
            "CUSTODY_POLICY_DIGEST_MISMATCH",
            "CUSTODY_AUTHORITY_UNTRUSTED",
            "CUSTODY_AUTHORITY_TIME_INVALID",
            "CUSTODY_APPROVAL_SIGNATURE_INVALID"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[\\x20-\\x7e]+$"
        }
      },
      "required": [
        "code",
        "message",
        "subject"
      ],
      "additionalProperties": false
    }
  }
}
