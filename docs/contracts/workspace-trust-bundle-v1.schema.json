{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/__schema0"
    },
    "kind": {
      "$ref": "#/$defs/__schema1"
    },
    "workspace": {
      "$ref": "#/$defs/__schema2"
    },
    "revision": {
      "$ref": "#/$defs/__schema3"
    },
    "keys": {
      "$ref": "#/$defs/__schema4"
    },
    "integrity": {
      "$ref": "#/$defs/__schema13"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "workspace",
    "revision",
    "keys",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "kernel-zero.dev/custody/v1"
    },
    "__schema1": {
      "type": "string",
      "const": "WorkspaceTrustBundle"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "__schema3": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema5"
      }
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "keyId": {
          "$ref": "#/$defs/__schema6"
        },
        "kty": {
          "$ref": "#/$defs/__schema7"
        },
        "crv": {
          "$ref": "#/$defs/__schema8"
        },
        "x": {
          "$ref": "#/$defs/__schema9"
        },
        "validFrom": {
          "$ref": "#/$defs/__schema10"
        },
        "validUntil": {
          "$ref": "#/$defs/__schema11"
        },
        "revokedFrom": {
          "$ref": "#/$defs/__schema12"
        }
      },
      "required": [
        "keyId",
        "kty",
        "crv",
        "x",
        "validFrom",
        "validUntil",
        "revokedFrom"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "__schema7": {
      "type": "string",
      "const": "OKP"
    },
    "__schema8": {
      "type": "string",
      "const": "Ed25519"
    },
    "__schema9": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "__schema10": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "__schema11": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema12": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema10"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "algorithm",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
