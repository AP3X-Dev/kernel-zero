# Local development only. Production must supply every required value explicitly.
NODE_ENV=development
DATABASE_URL=postgresql://kernel_zero:kernel_zero@127.0.0.1:5432/kernel_zero
KERNEL_ZERO_APP_URL=http://127.0.0.1:3000
KERNEL_ZERO_IDENTITY_SECRET=local-only-change-before-production-32-bytes
KERNEL_ZERO_REGISTRATION_OPEN=true
KERNEL_ZERO_EMAIL_MODE=local-outbox

