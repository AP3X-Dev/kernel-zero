# Local development only. Production must supply every required value explicitly.
NODE_ENV=development
DATABASE_URL=postgresql://kernel_zero:kernel_zero@127.0.0.1:5432/kernel_zero
# CI presents this as `Authorization: Bearer <token>` on POST /api/evidence/v1/runs. At least 32 characters.
KERNEL_ZERO_EVIDENCE_TOKEN=local-only-change-before-production-32-bytes
# Optional. Scopes every stored row and must match `--workspace` on the validator. Defaults to the repository's own id.
# KERNEL_ZERO_WORKSPACE_ID=00000000-0000-7000-8000-000000000000
